  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.thrive/session-start.mjs\""
          }
        ]
      }
    ]
  }
}
