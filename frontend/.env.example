# OAuth client ID from Google Cloud Console → APIs & Services → Credentials
VITE_GOOGLE_CLIENT_ID=

# Google Sheet ID (from the sheet URL: docs.google.com/spreadsheets/d/<THIS_ID>/edit)
VITE_SPREADSHEET_ID=

# Set to "true" to skip Google auth and use sample data (no GCP setup needed)
VITE_DEMO_MODE=

# The Apps Script API's live /exec URL (#410), not a secret. With it set, Sync now
# asks the API to dispatch at once; unset, the 5-minute poller picks the request up.
# The API's TOKEN_CLIENT_ID script property must equal VITE_GOOGLE_CLIENT_ID.
VITE_THRIVE_API_URL=
